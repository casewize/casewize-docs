{
  "name": "casewize-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3050",
    "build": "node scripts/build-ask-index.mjs && next build",
    "start": "next start --port 3050",
    "ask:index": "node scripts/build-ask-index.mjs",
    "typecheck": "tsc --noEmit",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind"
  },
  "dependencies": {
    "next": "15.5.24",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "dotenv": "^17.4.2",
    "pagefind": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "zod": "4.1.13"
  },
  "engines": {
    "node": ">=20"
  }
}
